# Copy to .env and fill in. Never commit .env.

# SQLite file for local use. For Postgres, change the provider in prisma/schema.prisma.
DATABASE_URL="file:./repoguard.db"

# Public URL of the app (used by NextAuth for OAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"
# Random secret: openssl rand -base64 32
NEXTAUTH_SECRET=""

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: comma-separated GitHub logins allowed to sign in (recommended for a personal tool)
ALLOWED_GITHUB_LOGINS=""

# Optional: key used to encrypt stored GitHub tokens (defaults to a key derived from NEXTAUTH_SECRET)
TOKEN_ENCRYPTION_KEY=""

# Optional: secret for the scheduled scan endpoint (/api/cron). Send as "Authorization: Bearer <secret>".
CRON_SECRET=""


# Optional AI features: per-finding review and attack-scenario analysis (send findings and short, secret-masked code excerpts to the Claude API).
# Off unless set to "true".
AI_REVIEW_ENABLED="false"
ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5-5
AI_REVIEW_MODEL=""

# Optional: secret for signing exported reports (so an admin can verify authenticity).
# Defaults to a key derived from NEXTAUTH_SECRET if unset.
REPORT_SIGNING_SECRET=""
